{
  "name": "pi-local-extensions",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "cloud-agent": "bun ./scripts/cloud-agent.ts",
    "agent-status": "bun ./scripts/agent-status.ts",
    "test": "bun test --pass-with-no-tests"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "typebox": "1.3.27",
    "@types/node": "^24.5.0",
    "cac": "^6.7.14",
    "typescript": "^5.9.2"
  }
}
