#!/usr/bin/env bash
# SSH arguments intentionally expand locally; interpolated paths are fixed or validated.
# shellcheck disable=SC2029
set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "usage: $0" >&2
  exit 1
fi

cd "$(dirname "$0")/.."
builder=hetzner-2
target=hetzner-1
helper=/run/current-system/sw/bin/activate-dnd-character-sheet

# Verify direct builder-to-target access and the one-time NixOS setup before building.
ssh "$builder" "ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10 '$target' /run/wrappers/bin/sudo -n '$helper' --check"

work_dir="$(ssh "$builder" 'mktemp -d /tmp/deploy-dnd.XXXXXXXX')"
if [[ ! "$work_dir" =~ ^/tmp/deploy-dnd\.[a-zA-Z0-9]+$ ]]; then
  echo "Unexpected builder temporary directory: $work_dir" >&2
  exit 1
fi
cleanup() {
  ssh "$builder" "rm -rf -- '$work_dir'" >&2 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Use the local lock file (including uncommitted updates), without changing
# either server's config checkout. The result symlink roots the build until
# the target has imported it and installed its own profile generation.
tar -czf - flake.nix flake.lock nix scripts | ssh "$builder" "tar -xzf - -C '$work_dir'"
echo "Building D&D on $builder..." >&2
package="$(ssh "$builder" "bash -s -- '$work_dir'" <<'BUILD'
set -euo pipefail
cd "$1"
# Use the read-only D&D deploy key for this build only. Ignore the shared SSH
# configuration, whose GitHub key belongs to Obsidian; still verify host keys.
export GIT_SSH_COMMAND="ssh -F /dev/null -i '$HOME/.ssh/github-dnd-character-sheet' -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes"
nix build --out-link "$1/result" --print-out-paths --no-write-lock-file \
  --impure --expr '(builtins.getFlake (toString ./.)).inputs."dnd-character-sheet".packages.x86_64-linux.website'
BUILD
)"
if [[ ! "$package" =~ ^/nix/store/[a-z0-9]{32}-dnd-character-sheet-website-[a-zA-Z0-9.+_-]+$ ]]; then
  echo "Unexpected build output: $package" >&2
  exit 1
fi

echo "Streaming missing runtime paths directly from $builder to $target and activating $package..." >&2
# No build dependencies or intermediate archive are stored on hetzner-1.
# A privileged import avoids granting the SSH user blanket Nix trusted-user
# permissions. Only control traffic passes through this machine.
ssh "$builder" "bash -s -- '$package' '$target' '$helper'" <<'EXPORT'
set -euo pipefail
package="$1"
target="$2"
helper="$3"
ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10)
closure="$(nix-store --query --requisites "$package")"
[[ -n "$closure" ]]
mapfile -t paths <<< "$closure"
missing="$(ssh -n "${ssh_options[@]}" "$target" nix-store --check-validity --print-invalid "${paths[@]}")"
# Always include the application, even on redeploy: the activation helper
# requires it in the import result before switching the profile.
mapfile -t transfer_paths < <(printf '%s\n' "$package" "$missing" | grep -v '^$' | sort -u)
echo "Transferring ${#transfer_paths[@]} of ${#paths[@]} runtime paths (including the application)..." >&2
nix-store --export "${transfer_paths[@]}" |
  ssh "${ssh_options[@]}" "$target" "/run/wrappers/bin/sudo -n '$helper' '$package'"
EXPORT

echo "D&D deployed successfully."
