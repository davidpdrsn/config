#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: $0 <1|2>" >&2
  exit 1
fi

case "$1" in
  1) host="hetzner-1" ;;
  2) host="hetzner-2" ;;
  *)
    echo "error: invalid VPS '$1' (expected 1 or 2)" >&2
    exit 1
    ;;
esac

ssh -t "$host" 'cd /home/davidpdrsn/config && jj git fetch && jj new main && ./scripts/bootstrap-pi-deps && /run/wrappers/bin/sudo nixos-rebuild switch --flake ".#$(hostname)"'
