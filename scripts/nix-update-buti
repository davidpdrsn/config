#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package_file="$root_dir/nix/machines/macbook-pro/packages/buti.nix"

for command in curl jq nix python3; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf '%s not found. Install it first.\n' "$command" >&2
    exit 1
  fi
done

release="$(curl --fail --silent --show-error https://api.github.com/repos/BartInTheField/buti/releases/latest)"
version="$(jq -er '.tag_name | select(test("^[0-9]+(\\.[0-9]+)+$"))' <<< "$release")"
url="https://github.com/BartInTheField/buti/releases/download/$version/buti_${version}_darwin_arm64.tar.gz"
jq -e --arg url "$url" '.assets | any(.browser_download_url == $url)' <<< "$release" >/dev/null
hash="$(nix store prefetch-file --json "$url" | jq -er '.hash')"

python3 - "$package_file" "$version" "$hash" <<'PY'
import re
import sys
from pathlib import Path

package_file = Path(sys.argv[1])
version, hash_value = sys.argv[2:]
if not re.fullmatch(r"sha256-[A-Za-z0-9+/]{43}=", hash_value):
    raise SystemExit("Invalid SHA-256 hash returned by Nix")

contents = package_file.read_text()
for key, value in [("version", version), ("hash", hash_value)]:
    contents, count = re.subn(
        rf'(?m)^(\s*{key} = )"[^"]+";',
        lambda match: f'{match[1]}"{value}";',
        contents,
    )
    if count != 1:
        raise SystemExit(f"Expected exactly one {key} in {package_file}")
package_file.write_text(contents)
PY

printf 'Updated buti to %s\n' "$version"
